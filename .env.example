# MySQL administrado en DigitalOcean. Copia este archivo como .env.local
# durante el desarrollo o como .env.production durante el despliegue.
MYSQL_HOST=db-mysql-REGION-do-user-ID-0.k.db.ondigitalocean.com
MYSQL_PORT=25060
MYSQL_USER=your_database_user
MYSQL_PASSWORD=replace_with_your_database_password
MYSQL_DATABASE=avanza

# Ruta opcional al certificado CA. Déjala vacía al usar un túnel SSH local.
MYSQL_SSL_CA_PATH=./certs/ca-certificate.crt
